{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zuotiben-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://zuotiben.top,https://www.zuotiben.top",
    "PUBLIC_CACHE_SECONDS": "60"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}
