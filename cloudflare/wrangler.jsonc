{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zuotiben-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://zuotiben.top,https://www.zuotiben.top",
    "PUBLIC_CACHE_SECONDS": "60",
    "BACKEND_MODE": "d1-only"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuotiben-api-db",
      "database_id": "801f870c-f481-4dfa-b1ac-c0f9045aae7e",
      "migrations_dir": "migrations"
    }
  ]
}
